# --- Database ---
# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/ai-interviewer

# --- Groq (replaces OpenAI Realtime) ---
# API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Deepgram (speech-to-text on frontend) ---
# API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:3001/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Frontend URL ---
# Used for OAuth redirects
FRONTEND_URL=http://localhost:3000

# --- Proxy (GitHub scraping) ---
# HTTP/HTTPS proxy URL for outbound requests
PROXY_URL=http://user:pass@host:port

# --- Server ---
PORT=3001

# --- LinkedIn scraper (index2.js only) ---
LINKEDIN_PROXY_PORT=
LINKEDIN_TIMEOUT_MS=30000
HEADLESS=true
DATAIMPULSE_PROXY_URL=
DATAIMPULSE_PROXY_SERVER=
DATAIMPULSE_PROXY_HOST=
DATAIMPULSE_PROXY_PORT=
DATAIMPULSE_PROXY_USERNAME=
DATAIMPULSE_PROXY_PASSWORD=
PROXY_USERNAME=
PROXY_PASSWORD=
LINKEDIN_USER_AGENT=
