# --- Backend API ---
# URL of the backend Express server
BACKEND_URL=http://localhost:3001

# --- Deepgram (speech-to-text) ---
# Public env vars prefixed with BUN_PUBLIC_ are available to the frontend
# via Bun's bundler (see bunfig.toml). The backend /api/v1/config endpoint
# also provides this key at runtime.
BUN_PUBLIC_DEEPGRAM_API_KEY=
