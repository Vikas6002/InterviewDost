generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(uuid())
  githubId      String      @unique
  username      String
  avatarUrl     String?
  credits       Int         @default(50)
  isUnlimited   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  interviews    Interview[]
  sessions      Session[]
  payments      Payment[]
  atsChecks     AtsCheck[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  razorpayId  String   @unique
  amount      Int
  credits     Int
  tier        String
  status      String   @default("created")
  createdAt   DateTime @default(now())
}

model Interview {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  type            InterviewType
  githubMetadata  Json?
  jobRole         String?
  resumeText      String?
  status          InterviewStatus
  score           Int       @default(0)
  conversations   Message[]
  feedback        String?
  createdAt       DateTime  @default(now())
}

model AtsCheck {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  resumeText     String
  jobDescription String
  score          Int
  keywordMatches Json
  missingSkills  Json
  suggestions    String
  summary        String
  createdAt      DateTime @default(now())
}

model Message {
  id          String     @id  @default(uuid())
  message     String
  type        MessageType
  interviewId String
  interview   Interview  @relation(fields: [interviewId], references: [id])
  createdAt   DateTime   @default(now())
}

enum MessageType {
  User
  Assistant
}

enum InterviewType {
  GitHub
  Resume
}

enum InterviewStatus {
  Pre
  InProgress
  Done
}
